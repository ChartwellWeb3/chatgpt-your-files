# Original Supabase project: login, profiles, all chatbot data and content.
# Keep these values pointing to the existing project.
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# New Supabase project: website performance only. Server-side values.
# Use the new project's sb_secret_... key (legacy service_role also works).
# Leave blank until the project exists; the performance API returns a setup error.
# Never prefix the secret with NEXT_PUBLIC_ or commit a real value.
PERFORMANCE_SUPABASE_URL=
PERFORMANCE_SUPABASE_SECRET_KEY=
# One performance environment per app deployment: qa for QA, prod for production.
# Required; the dashboard shows this value as a badge and has no environment picker.
PERFORMANCE_ENVIRONMENT=qa

OPENAI_API_KEY=your-openai-key
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# Sitecore Delivery GraphQL
SITECORE_GRAPHQL_ENDPOINT=https://your-sitecore-host/api/graphql/v1
SITECORE_EDGE_CONTEXT_ID=your-sitecore-edge-context-id
SITECORE_GQL_TOKEN=your-sitecore-gql-token
SITECORE_RESIDENCE_DATASOURCE=/sitecore/content/sxastarter/sxastarter/Data/Shared Content/ProvinceCityResidenceSelector
