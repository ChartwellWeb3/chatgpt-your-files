# Original Supabase project: login, profiles, all chatbot data and content.
# Keep these values pointing to the existing project.
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# New Supabase project: performance, GEO, and Sitecore pricing imports. Server-side values.
# Use the new project's sb_secret_... key (legacy service_role also works).
# Leave blank until the project exists; the performance API returns a setup error.
# Never prefix the secret with NEXT_PUBLIC_ or commit a real value.
PERFORMANCE_SUPABASE_URL=
PERFORMANCE_SUPABASE_SECRET_KEY=
# One performance environment per app deployment: qa for QA, prod for production.
# Required; the dashboard shows this value as a badge and has no environment picker.
PERFORMANCE_ENVIRONMENT=qa

OPENAI_API_KEY=your-openai-key
OPENAI_ANALYSIS_MODEL=gpt-5.6-luna

# GEO uses the same OPENAI_API_KEY with independent model settings.
# Monitor: a model supporting Responses web_search. Analysis: Structured Outputs.
# Set explicit model IDs available to this OpenAI project; no chatbot fallback.
OPENAI_GEO_MONITOR_MODEL=
OPENAI_GEO_ANALYSIS_MODEL=

# Sitecore Delivery GraphQL
SITECORE_GRAPHQL_ENDPOINT=https://your-sitecore-host/api/graphql/v1
SITECORE_EDGE_CONTEXT_ID=your-sitecore-edge-context-id
SITECORE_GQL_TOKEN=your-sitecore-gql-token
SITECORE_RESIDENCE_DATASOURCE=/sitecore/content/sxastarter/sxastarter/Data/Shared Content/ProvinceCityResidenceSelector

# Pricing dashboard: server-only values, also set in performance Edge secrets.
# Shared across DEV, QA, and PROD. Optional environment-specific overrides win.
SITECORE_PRICING_PROPERTY_TEMPLATE_ID={8A4FBFEA-94DC-41CF-B6B8-CECA339490B1}
SITECORE_PRICING_SUITE_TEMPLATE_ID={CB593602-63B9-4ACF-B9C7-3E2A56AEFCC1}
SITECORE_PRICING_CONTENT_ROOT=/sitecore/content/sxastarter/sxastarter/home
SITECORE_PRICING_TIMEZONE=America/Toronto

# Each environment has its own CM host and environment automation client.
SITECORE_PRICING_DEV_CM_URL=https://xmc-chartwellmaa139-chartwellsxa-dev.sitecorecloud.io
SITECORE_PRICING_DEV_CLIENT_ID=
SITECORE_PRICING_DEV_CLIENT_SECRET=

SITECORE_PRICING_QA_CM_URL=https://xmc-chartwellmabc8a-chartwellsxa-cwqa.sitecorecloud.io
SITECORE_PRICING_QA_CLIENT_ID=
SITECORE_PRICING_QA_CLIENT_SECRET=

# Use the verified PROD CM origin, with no /sitecore path or query string.
SITECORE_PRICING_PROD_CM_URL=
SITECORE_PRICING_PROD_CLIENT_ID=
SITECORE_PRICING_PROD_CLIENT_SECRET=

# Optional override example: SITECORE_PRICING_QA_CONTENT_ROOT=/sitecore/content/...
# Same random 32+ character secret in Next.js, pricing Edge Function, and Vault.
SITECORE_PRICING_DISPATCH_SECRET=
